#!/usr/bin/env bash
set -e

read -r ACTION DEVICE || true
SYSFS="/sys/class/input/${DEVICE}/inhibited"

if [ ! -f "$SYSFS" ]; then
    echo "Error: Device '${DEVICE}' not found"
    exit 1
fi

case "$ACTION" in
    on)
        echo 0 > "$SYSFS"
        echo "Activated ${DEVICE}"
        ;;
    off)
        echo 1 > "$SYSFS"
        echo "Deactivated ${DEVICE}"
        ;;
    toggle)
        [ "$(cat "$SYSFS")" = "0" ] && echo 1 > "$SYSFS" || echo 0 > "$SYSFS"
        echo "Toggled ${DEVICE}"
        ;;
    *)
        echo "Usage: <on|off|toggle> [input*]"
        exit 1
        ;;
esac
